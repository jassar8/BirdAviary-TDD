<UserControl x:Class="BirdAviary.Views.TddTestingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Counters -->
            <UniformGrid Columns="2" Margin="0,0,0,16">
                <Border Style="{StaticResource GlassCard}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="12" Height="12" Fill="{StaticResource SuccessBrush}" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Passed" Style="{StaticResource StatTitle}"/>
                            <TextBlock Text="{Binding PassedCount}" Style="{StaticResource StatValue}" FontSize="22"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GlassCard}" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="12" Height="12" Fill="{StaticResource DangerBrush}" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Failed" Style="{StaticResource StatTitle}"/>
                            <TextBlock Text="{Binding FailedCount}" Style="{StaticResource StatValue}" FontSize="22"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Mock Panel -->
                <Border Grid.Column="0" Style="{StaticResource GlassCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Mock Service Simulation" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding MockStatus}" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Run Tests" Command="{Binding RunTestsCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                            <Button Content="Simulate Moq" Command="{Binding SimulateMockCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                            <Button Content="Run Benchmark" Command="{Binding RunBenchmarkCommand}"
                                    Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Benchmark -->
                <Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Sorting Benchmark" Style="{StaticResource SectionTitle}"/>
                        <ItemsControl ItemsSource="{Binding BenchmarkResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E2228" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding AlgorithmName}"
                                                           Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding ItemCount, StringFormat={}{0:N0} items}"
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ElapsedMilliseconds, StringFormat={}{0} ms}"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Test Results -->
            <Border Style="{StaticResource GlassCard}">
                <StackPanel>
                    <TextBlock Text="Test Results" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl ItemsSource="{Binding TestResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E2228" CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Passed, Converter={StaticResource PassFailIcon}}"
                                                   FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TestName}"
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"
                                                   VerticalAlignment="Center" Margin="8,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Message}"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="3" Text="{Binding DurationMs, StringFormat={}{0}ms}"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
