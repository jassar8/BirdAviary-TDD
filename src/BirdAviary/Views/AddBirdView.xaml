<UserControl x:Class="BirdAviary.Views.AddBirdView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:BirdAviary.Converters">
    <UserControl.Resources>
        <conv:BoolToColorConverter x:Key="BoolToColor"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource GlassCard}" MaxWidth="560" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Register New Bird" Style="{StaticResource SectionTitle}" FontSize="18"/>

                <TextBlock Text="Ring ID" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <TextBox Text="{Binding RingId, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

                <TextBlock Text="Bird Type" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding BirdTypes}"
                          SelectedItem="{Binding SelectedType}"
                          Style="{StaticResource ModernComboBox}" Margin="0,0,0,16"/>

                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6">
                    <Run Text="Color / Mutation"/>
                    <Run Text=" (English or Hebrew letters only)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                </TextBlock>
                <TextBox Text="{Binding ColorMutation, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

                <TextBlock Text="Hatch Year" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <TextBox Text="{Binding HatchYearText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

                <TextBlock Text="Status" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding BirdStatuses}"
                          SelectedItem="{Binding SelectedStatus}"
                          Style="{StaticResource ModernComboBox}" Margin="0,0,0,16"/>

                <CheckBox Content="Available for Sale" IsChecked="{Binding AvailableForSale}"
                          Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>

                <!-- Validation Errors -->
                <ItemsControl ItemsSource="{Binding ValidationErrors}" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat=⚠ {0}}"
                                       Foreground="{StaticResource DangerBrush}"
                                       FontSize="13" Margin="0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{Binding IsSuccess, Converter={StaticResource BoolToColor}}"
                           FontSize="13" Margin="0,0,0,16"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Save Bird" Command="{Binding SaveBirdCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,12,0"/>
                    <Button Content="Clear" Command="{Binding ClearFormCommand}"
                            Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
