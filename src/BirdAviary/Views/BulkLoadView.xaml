<UserControl x:Class="BirdAviary.Views.BulkLoadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:BirdAviary.Converters">
    <UserControl.Resources>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
    </UserControl.Resources>
    <Border Style="{StaticResource GlassCard}" MaxWidth="640" HorizontalAlignment="Left">
        <StackPanel>
            <TextBlock Text="Bulk Data Generation" Style="{StaticResource SectionTitle}" FontSize="18"/>
            <TextBlock Text="Generate 10,000 random birds for performance testing and inventory stress tests."
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,24"/>

            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="14" Margin="0,0,0,12"/>

            <ProgressBar Value="{Binding Progress}" Maximum="100"
                         Style="{StaticResource ModernProgressBar}" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding Progress, StringFormat={}{0:F0}%}"
                       Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,0,0,20"/>

            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="#1E2228" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Birds Generated" Style="{StaticResource StatTitle}"/>
                        <TextBlock Text="{Binding BirdsGenerated, StringFormat=N0}"
                                   Style="{StaticResource StatValue}" FontSize="22"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#1E2228" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Performance Timer" Style="{StaticResource StatTitle}"/>
                        <TextBlock Text="{Binding ElapsedTime}" Foreground="{StaticResource AccentBrush}"
                                   FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Button Content="Generate 10,000 Birds" Command="{Binding GenerateBirdsCommand}"
                    Style="{StaticResource PrimaryButton}" IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"
                    HorizontalAlignment="Left"/>
        </StackPanel>
    </Border>
</UserControl>
