<UserControl x:Class="BirdAviary.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,24">
            <!-- Stat Cards -->
            <UniformGrid Columns="4" Margin="0,0,0,24">
                <Border Style="{StaticResource GlassCard}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="🐦" FontSize="24" Margin="0,0,0,8"/>
                        <TextBlock Text="Total Birds" Style="{StaticResource StatTitle}"/>
                        <TextBlock Text="{Binding TotalBirds}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GlassCard}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="💰" FontSize="24" Margin="0,0,0,8"/>
                        <TextBlock Text="Available for Sale" Style="{StaticResource StatTitle}"/>
                        <TextBlock Text="{Binding AvailableForSale}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GlassCard}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="📅" FontSize="24" Margin="0,0,0,8"/>
                        <TextBlock Text="Average Age (years)" Style="{StaticResource StatTitle}"/>
                        <TextBlock Text="{Binding AverageAge}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GlassCard}">
                    <StackPanel>
                        <TextBlock Text="🏥" FontSize="24" Margin="0,0,0,8"/>
                        <TextBlock Text="In Isolation" Style="{StaticResource StatTitle}"/>
                        <TextBlock Text="{Binding BirdsInIsolation}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Chart -->
                <Border Grid.Column="0" Style="{StaticResource GlassCard}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Bird Type Distribution" Style="{StaticResource SectionTitle}"/>
                        <ItemsControl ItemsSource="{Binding TypeDistribution}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Height="22" CornerRadius="4"
                                                Background="#1E2228" Margin="8,0" VerticalAlignment="Center">
                                            <Border Height="22" CornerRadius="4" HorizontalAlignment="Left"
                                                    Background="{StaticResource AccentBrush}"
                                                    Width="{Binding BarWidth}"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Value}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Recent Activity -->
                <Border Grid.Column="1" Style="{StaticResource GlassCard}">
                    <StackPanel>
                        <TextBlock Text="Recent Activity" Style="{StaticResource SectionTitle}"/>
                        <ItemsControl ItemsSource="{Binding RecentActivities}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E2228" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Description}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="13" VerticalAlignment="Center" Margin="8,0"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Timestamp, StringFormat=HH:mm}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
